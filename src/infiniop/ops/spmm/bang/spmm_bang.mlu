#include "../../../devices/bang/common_bang.h"
#include "spmm_bang.h"
#include "spmm_bang_kernel.mlu"

namespace op::spmm::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopTensorDescriptor_t c_desc,
    infiniopSpMatDescriptor_t a_desc,
    infiniopTensorDescriptor_t b_desc) {

    auto handle = reinterpret_cast<device::bang::cambricon::Handle *>(handle_);
    auto dtype = c_desc->dtype();
    auto index_dtype = a_desc->crowIndicesDesc()->dtype();

    CHECK_DTYPE(dtype, INFINI_DTYPE_F32);
    CHECK_DTYPE(index_dtype, INFINI_DTYPE_I32, INFINI_DTYPE_I64);

    auto result = SpMMInfo::create(c_desc, a_desc, b_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        dtype,
        index_dtype,
        result.take(),
        a_desc,
        0,
        new Opaque{handle->internal()},
        handle->device,
        handle->device_id);
    return INFINI_STATUS_SUCCESS;
}

template <typename Tindex>
static infiniStatus_t calculateByIndex(
    const SpMMInfo &info,
    infiniopSpMatDescriptor_t a_desc,
    int core_per_cluster,
    int cluster_count,
    void *c,
    const void *b,
    float alpha,
    float beta,
    cnrtQueue_t queue) {

    cnrtDim3_t dim = {
        utils::cast<unsigned int>(core_per_cluster),
        utils::cast<unsigned int>(cluster_count),
        1};
    cnrtFunctionType_t type = cnrtFuncTypeUnion1;

    int rows = utils::cast<int>(info.m);
    int cols = utils::cast<int>(info.n);
    int b_row_stride = utils::cast<int>(info.b_matrix.row_stride);
    int b_col_stride = utils::cast<int>(info.b_matrix.col_stride);
    int c_row_stride = utils::cast<int>(info.c_matrix.row_stride);
    int c_col_stride = utils::cast<int>(info.c_matrix.col_stride);
    auto crow_indices = reinterpret_cast<const Tindex *>(a_desc->crowIndices());
    auto col_indices = reinterpret_cast<const Tindex *>(a_desc->colIndices());
    auto values = reinterpret_cast<const float *>(a_desc->values());
    auto b_data = reinterpret_cast<const float *>(b);
    auto c_data = reinterpret_cast<float *>(c);

    bool contiguous_cols = b_col_stride == 1 && c_col_stride == 1;
    int align_elements = utils::cast<int>(ALIGN_SIZE / sizeof(float));
    int max_col_block = utils::cast<int>((NRAM_MAX_SIZE - ALIGN_SIZE) / (2 * sizeof(float)));
    int col_block = (max_col_block / align_elements) * align_elements;
    if (col_block <= 0) {
        col_block = align_elements;
    }

    if (alpha == 0.0f || info.nnz == 0) {
        if (contiguous_cols) {
            spmmCsrF32ScaleCContiguousKernel<<<dim, type, queue>>>(
                rows,
                cols,
                c_data,
                c_row_stride,
                col_block,
                beta);
        } else {
            spmmCsrF32ScaleCKernel<<<dim, type, queue>>>(
                rows,
                cols,
                c_data,
                c_row_stride,
                c_col_stride,
                beta);
        }
    } else if (cols == 1 && b_col_stride == 1 && c_col_stride == 1) {
        spmmCsrF32SpmvKernel<Tindex><<<dim, type, queue>>>(
            rows,
            crow_indices,
            col_indices,
            values,
            b_data,
            b_row_stride,
            c_data,
            c_row_stride,
            alpha,
            beta);
    } else if (contiguous_cols) {
        spmmCsrF32ContiguousKernel<Tindex><<<dim, type, queue>>>(
            rows,
            cols,
            crow_indices,
            col_indices,
            values,
            b_data,
            b_row_stride,
            c_data,
            c_row_stride,
            col_block,
            alpha,
            beta);
    } else {
        spmmCsrF32StridedKernel<Tindex><<<dim, type, queue>>>(
            rows,
            cols,
            crow_indices,
            col_indices,
            values,
            b_data,
            b_row_stride,
            b_col_stride,
            c_data,
            c_row_stride,
            c_col_stride,
            alpha,
            beta);
    }

    cnrtQueueSync(queue);
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    void *c,
    const void *b,
    float alpha,
    float beta,
    void *stream) const {

    (void)workspace;
    if (workspace_size < _workspace_size) {
        return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
    }
    if (_dtype != INFINI_DTYPE_F32) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    auto queue = reinterpret_cast<cnrtQueue_t>(stream);
    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();
    switch (_index_dtype) {
    case INFINI_DTYPE_I32:
        return calculateByIndex<int32_t>(_info, _a_desc, core_per_cluster, cluster_count, c, b, alpha, beta, queue);
    case INFINI_DTYPE_I64:
        return calculateByIndex<int64_t>(_info, _a_desc, core_per_cluster, cluster_count, c, b, alpha, beta, queue);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

} // namespace op::spmm::bang
