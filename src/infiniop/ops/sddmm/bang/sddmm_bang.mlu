#include "../../../devices/bang/common_bang.h"
#include "sddmm_bang.h"
#include "sddmm_bang_kernel.mlu"

namespace op::sddmm::bang {

struct Descriptor::Opaque {
    std::shared_ptr<device::bang::Handle::Internal> internal;
};

Descriptor::~Descriptor() {
    delete _opaque;
}

infiniStatus_t Descriptor::create(
    infiniopHandle_t handle_,
    Descriptor **desc_ptr,
    infiniopSpMatDescriptor_t c_desc,
    infiniopTensorDescriptor_t a_desc,
    infiniopTensorDescriptor_t b_desc) {
    auto handle = reinterpret_cast<device::bang::cambricon::Handle *>(handle_);
    auto dtype = c_desc->valuesDesc()->dtype();
    auto index_dtype = c_desc->crowIndicesDesc()->dtype();

    CHECK_DTYPE(dtype, INFINI_DTYPE_F32);
    CHECK_DTYPE(index_dtype, INFINI_DTYPE_I32, INFINI_DTYPE_I64);

    auto result = SDDMMInfo::create(c_desc, a_desc, b_desc);
    CHECK_RESULT(result);

    *desc_ptr = new Descriptor(
        dtype,
        index_dtype,
        result.take(),
        c_desc,
        0,
        new Opaque{handle->internal()},
        handle->device,
        handle->device_id);
    return INFINI_STATUS_SUCCESS;
}

template <typename Tindex>
static infiniStatus_t calculateByIndex(
    const SDDMMInfo &info,
    infiniopSpMatDescriptor_t c_desc,
    int core_per_cluster,
    int cluster_count,
    void *c_values,
    const void *a,
    const void *b,
    float alpha,
    float beta,
    cnrtQueue_t queue) {
    cnrtDim3_t dim = {
        utils::cast<unsigned int>(core_per_cluster),
        utils::cast<unsigned int>(cluster_count),
        1};
    cnrtFunctionType_t type = cnrtFuncTypeUnion1;

    int rows = utils::cast<int>(info.m);
    int k_dim = utils::cast<int>(info.k);
    int nnz = utils::cast<int>(info.nnz);
    int a_row_stride = utils::cast<int>(info.a_matrix.row_stride);
    int a_col_stride = utils::cast<int>(info.a_matrix.col_stride);
    int b_row_stride = utils::cast<int>(info.b_matrix.row_stride);
    int b_col_stride = utils::cast<int>(info.b_matrix.col_stride);
    auto crow = reinterpret_cast<const Tindex *>(c_desc->crowIndices());
    auto col = reinterpret_cast<const Tindex *>(c_desc->colIndices());
    auto a_data = reinterpret_cast<const float *>(a);
    auto b_data = reinterpret_cast<const float *>(b);
    auto c_data = reinterpret_cast<float *>(c_values);

    if (alpha == 0.0f || nnz == 0 || k_dim == 0) {
        sddmmCsrF32ScaleCKernel<<<dim, type, queue>>>(
            nnz,
            c_data,
            beta);
    } else if (a_col_stride == 1) {
        int align_elements = utils::cast<int>(ALIGN_SIZE / sizeof(float));
        int max_full_k = utils::cast<int>((NRAM_MAX_SIZE - ALIGN_SIZE) / (2 * sizeof(float)));
        int full_k_capacity = (max_full_k / align_elements) * align_elements;
        if (full_k_capacity <= 0) {
            full_k_capacity = align_elements;
        }

        if (k_dim <= full_k_capacity) {
            sddmmCsrF32ReuseAFullKKernel<Tindex><<<dim, type, queue>>>(
                rows,
                k_dim,
                crow,
                col,
                a_data,
                a_row_stride,
                b_data,
                b_row_stride,
                b_col_stride,
                c_data,
                alpha,
                beta);
        } else {
            sddmmCsrF32VectorKernel<Tindex><<<dim, type, queue>>>(
                rows,
                k_dim,
                full_k_capacity,
                crow,
                col,
                a_data,
                a_row_stride,
                b_data,
                b_row_stride,
                b_col_stride,
                c_data,
                alpha,
                beta);
        }
    } else {
        sddmmCsrF32StridedKernel<Tindex><<<dim, type, queue>>>(
            rows,
            k_dim,
            crow,
            col,
            a_data,
            a_row_stride,
            a_col_stride,
            b_data,
            b_row_stride,
            b_col_stride,
            c_data,
            alpha,
            beta);
    }

    cnrtQueueSync(queue);
    return INFINI_STATUS_SUCCESS;
}

infiniStatus_t Descriptor::calculate(
    void *workspace,
    size_t workspace_size,
    void *c_values,
    const void *a,
    const void *b,
    float alpha,
    float beta,
    void *stream) const {
    (void)workspace;
    if (workspace_size < _workspace_size) {
        return INFINI_STATUS_INSUFFICIENT_WORKSPACE;
    }
    if (_dtype != INFINI_DTYPE_F32) {
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }

    auto queue = reinterpret_cast<cnrtQueue_t>(stream);
    int core_per_cluster = _opaque->internal->getCorePerCluster();
    int cluster_count = _opaque->internal->getClusterCount();
    switch (_index_dtype) {
    case INFINI_DTYPE_I32:
        return calculateByIndex<int32_t>(_info, _c_desc, core_per_cluster, cluster_count, c_values, a, b, alpha, beta, queue);
    case INFINI_DTYPE_I64:
        return calculateByIndex<int64_t>(_info, _c_desc, core_per_cluster, cluster_count, c_values, a, b, alpha, beta, queue);
    default:
        return INFINI_STATUS_BAD_TENSOR_DTYPE;
    }
}

} // namespace op::sddmm::bang
